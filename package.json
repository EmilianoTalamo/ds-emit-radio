{
  "name": "ds-emit-radio",
  "version": "1.0.0",
  "description": "Simple Discord music bot",
  "main": "build/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --inspect ./src/main.ts",
    "start": "tsx --no-warnings ./src/main.ts",
    "lint": "lint-staged",
    "prepare": "husky",
    "commit": "cz",
    "upgrade": "npx -y npm-check-updates -u && npm i"
  },
  "author": "Emiliano Talamo",
  "license": "ISC",
  "devDependencies": {
    "@types/lodash": "4.17.20",
    "@types/node": "24.5.2",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-airbnb-typescript": "18.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-etc": "2.0.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.6.2"
  },
  "optionalDependencies": {
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "cz-git": "^1.12.0",
    "esbuild": "0.25.10",
    "ffmpeg-static": "5.2.0",
    "husky": "^9.1.7",
    "libsodium-wrappers": "0.7.15",
    "lint-staged": "16.2.0",
    "opusscript": "0.1.1"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.0",
    "@snazzah/davey": "0.1.6",
    "@spotify/web-api-ts-sdk": "1.2.0",
    "discord.js": "14.22.1",
    "dotenv": "17.2.2",
    "googleapis": "160.0.0",
    "lodash": "4.17.21",
    "query-string": "9.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "urlpattern-polyfill": "10.1.0",
    "ytmusic-api": "5.3.1"
  }
}
